# Configuración para Producción
ENVIRONMENT=production

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8084

# Base de Datos - Producción (usar variables de entorno del sistema)
# DB_HOST=your-production-db-host
# DB_PORT=5432
# DB_NAME=acueducto_hato_prod
# DB_USER=your-prod-user
# DB_PASSWORD=your-secure-password
# DB_SCHEMA=personal
# DB_MAX_CONNECTIONS=20

# Logging
RUST_LOG=info

# JWT (usar variables de entorno del sistema)
# JWT_SECRET=your-super-secure-jwt-secret
# JWT_EXPIRATION_HOURS=8