				{
					"name": "Obtener resumen financiero",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/dashboard",
							"host": ["{{base_url}}"],
							"path": ["dashboard"]
						},
						"description": "Retorna el resumen general: total ingresos, gastos, balance, deuda total y proyectos activos."
